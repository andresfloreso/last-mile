{
  "name": "import-service",
  "version": "1.0.0",
  "description": "Microservicio de importación de documentos (Excel/CSV) de planillas de envíos hacia delivery-service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/papaparse": "^5.3.14",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "ts-node-dev": "^2.0.0"
  }
}
