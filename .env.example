# Copiar como .env en la raíz del proyecto antes de levantar docker compose:
#   cp .env.example .env
# docker compose falla con un mensaje claro si falta alguna variable obligatoria.
# Nunca subas tu .env al repositorio (está en .gitignore).

# --- Obligatorias -----------------------------------------------------------

# Clave HS256 de los JWT. DEBE ser la misma para auth-service, delivery-service,
# api-gateway e import-service, porque todos firman/validan con ella.
# Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_SECRET=reemplaza_por_una_clave_aleatoria_de_al_menos_32_caracteres

# Contraseña del usuario de PostgreSQL. También la usan auth-service y
# delivery-service como contraseña del datasource.
# Ojo: PostgreSQL solo la aplica al crear el volumen; si la cambias, recrea el
# volumen (docker compose down -v) o cámbiala con ALTER USER.
POSTGRES_PASSWORD=reemplaza_por_la_clave_de_postgres

# Contraseña de Redis (--requirepass).
REDIS_PASSWORD=reemplaza_por_la_clave_de_redis

# --- Opcionales -------------------------------------------------------------

# ADMIN inicial (HU-05). auth-service lo crea al arrancar SOLO si no existe
# ningún usuario ADMIN. El registro público siempre crea usuarios CLIENT, así
# que este es el único modo de obtener el primer administrador.
# La contraseña debe tener al menos 8 caracteres. Si se dejan vacías, no se
# crea ningún ADMIN.
BOOTSTRAP_ADMIN_EMAIL=admin@lastmile.cl
BOOTSTRAP_ADMIN_PASSWORD=reemplaza_por_una_clave_segura
